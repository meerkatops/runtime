  "malformed": [
    {
      "query": "\"safe harbor",
      "position": 0,
      "reason": "unbalanced quote"
    },
    {
      "query": "(lease OR rental",
      "position": 0,
      "reason": "unbalanced open paren"
    },
    {
      "query": "lease OR rental)",
      "position": 15,
      "reason": "unbalanced close paren"
    },
    {
      "query": "lease OR",
      "position": 6,
      "reason": "dangling operator"
    },
    {
      "query": "AND merger",
      "position": 0,
      "reason": "dangling operator"
    },
    {
      "query": "notice /0 termination",
      "position": 7,
      "reason": "/0 is not a distance"
    },
    {
      "query": "force PRE/ majeure",
      "position": 6,
      "reason": "PRE/ needs a number"
    },
    {
      "query": "margin:term",
      "position": 0,
      "reason": "unknown zone"
    },
    {
      "query": "REGEX(\"[0-9\")",
      "position": 7,
      "reason": "unbalanced bracket in pattern"
    },
    {
      "query": "tenant_id:abc",
      "position": 0,
      "reason": "access fields cannot be searched"
    },
    {
      "query": "from: IN(counsel, partner",
      "position": 6,
      "reason": "unbalanced IN list"
    },
    {
      "query": "subject MATCHES INV",
      "position": 8,
      "reason": "MATCHES needs /pattern/"
    },
    {
      "query": "merger acquisition AND termination",
      "position": 7,
      "reason": "bare adjacency beside an operator; write AND or OR"
    },
    {
      "query": "indemn!",
      "position": 0,
      "reason": "no word forms for this word in the licensed list"
    }
  ],
  "outOfScope": [
    {
      "query": "recieve~",
      "reason": "fuzzy is written on a field, as subject~:recieve"
    },
    {
      "query": "comments:term",
      "reason": "the section is named comment, not comments"
    },
    {
      "query": "*",
      "reason": "every item in scope is the absence of a tree"
    }
  ]
}
