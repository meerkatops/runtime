{
  "name": "@scope/name",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "imports": {
    "#lib/*.js": { "source": "./src/lib/*.ts", "default": "./dist/lib/*.js" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --conditions=source --test",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
